# ============================================================
# AI 短剧管线 v2 — 环境变量配置
# ============================================================

# PostgreSQL（必须）
# 先创建数据库: CREATE DATABASE ai_drama;
AI_DRAMA_DB_DSN=postgresql://drama:drama123@127.0.0.1:5432/ai_drama

# ── LLM 服务商 API Key（在 system.yaml 的 llm.api_key 中填入，或设置下方 LLM_API_KEY） ──
# 硅基流动（推荐，多模型免费）: https://cloud.siliconflow.cn
# 智谱 AI（GLM-4-Flash 永久免费）: https://open.bigmodel.cn
# 阿里云百炼（新用户 7000 万 Token）: https://dashscope.aliyun.com
# 火山引擎（新用户 5000 万 Token）: https://console.volcengine.com/ark
# 腾讯混元（Lite 长期免费）: https://cloud.tencent.com/product/hunyuan
# 月之暗面 Kimi: https://platform.moonshot.cn
# 百度千帆（ERNIE-Speed 永久免费）: https://qianfan.cloud.baidu.com
# DeepSeek: https://platform.deepseek.com
# 魔搭社区: https://modelscope.cn
# 讯飞星火: https://xinghuo.xfyun.cn/sparkapi
# MODELSCOPE_API_KEY=
LLM_API_KEY=

# MiMo API（语音合成 — 免费）
# 获取: https://api.xiaomimimo.com
MIMO_API_KEY=

# Seko API（影视策划案 — seko.sensetime.com）
# 获取: https://seko.sensetime.com/explore
SEKO_API_KEY=

# Redis（必选 — Celery 任务队列）
REDIS_URL=redis://localhost:6379/0

# Redis 结果后端（可选，默认与 REDIS_URL 同地址的 db1）
# REDIS_BACKEND_URL=redis://localhost:6379/1

# CORS 跨域（可选，逗号分隔多个域名）
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# AI Toolkit 训练服务 API Key（Docker 部署时需要）
# AI_TOOLKIT_API_KEY=

# MusicGen API Key（AI 配乐生成 — 可选，自部署时可留空）
# RUNPOD_API_TOKEN=

# HuggingFace 镜像（模型下载加速）
# HF_ENDPOINT=https://hf-mirror.com
